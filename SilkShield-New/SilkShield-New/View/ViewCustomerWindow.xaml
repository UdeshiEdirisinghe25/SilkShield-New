<UserControl x:Class="SilkShield_New.View.ViewCustomerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="500" Width="500">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">

            <!-- Basic Info -->
            <Border CornerRadius="6" Background="#F5F5F5" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <Label Content="Basic Information" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>

                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Customer Name:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding CustomerName}" FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Property Type:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding CustomerType}" FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Phone:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding PhoneNumber}" FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Email:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Email}" FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Address:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Address}" TextWrapping="Wrap" FontSize="13"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Project Status -->
            <Border CornerRadius="6" Background="#F5F5F5" Padding="12" Margin="0,8,0,8">
                <StackPanel>
                    <Label Content="Project Status" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>

                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Visit Status:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding VisitedStatus}" Foreground="Green" FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quotation Status:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding QuotationStatus}" FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Project Confirmation:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProjectConfirmation}" Foreground="Green" FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Project Start Date:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Project_Start_Date}" FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Expected Completion:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Expected_Dateof_Completion}" FontSize="13"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Project Details -->
            <Border CornerRadius="6" Background="#F5F5F5" Padding="12" Margin="0,8,0,0">
                <StackPanel>
                    <Label Content="Project Details" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>

                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Property Details:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Property_Details}" FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Special Preferences:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Special_Preferances}" TextWrapping="Wrap" FontSize="13"/>
                    </Grid>

                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Notes:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Notes}" TextWrapping="Wrap" FontSize="13"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
