<Window x:Class="SilkShield_New.View.HistoryNew"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Invoice History"
        mc:Ignorable="d"
        Height="600" Width="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header/Search -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Filters -->

            <!-- DataGrid -->
        </Grid.RowDefinitions>
        

        <!-- Header + Search -->
        <Grid Grid.Row="0" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Invoice History"
                       FontSize="28" FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <!-- Search box -->
            <DockPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBox Width="250"
                         Height="30"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         Padding="5"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         />
                <Button Content="🔍"
                        Width="30"
                        Height="30"
                        Command="{Binding SearchCommand}"/>
            </DockPanel>
        </Grid>

        <!-- Date Filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,0,20,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="200" Height="30"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="200" Height="30"/>
            </StackPanel>

            <Button Content="Clear"
                    Width="80" Height="28"
                    Command="{Binding ClearFiltersCommand}"
                    Background="#FF5B281C"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"/>
        </StackPanel>

        <!-- DataGrid -->
        <Border Grid.Row="1" Margin="20,113,20,-73" CornerRadius="10" Background="White" Padding="10">
            <DataGrid ItemsSource="{Binding Invoices}"
                    
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                RowHeight="35"
                HeadersVisibility="Column"
                GridLinesVisibility="None"
                Background="White"
                Margin="20,0,20,10"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Invoice ID" Binding="{Binding InvoiceID}" Width="*" />
                    <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="2*" />
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="*" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="*" />


                    <!-- Action Column -->
                    <DataGridTemplateColumn Header="Action" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                    <Button Content="👁" Margin="2"
                        Background="Transparent" BorderBrush="Transparent"
                        FontSize="12" Cursor="Hand"
                        Foreground="Green"
                        Command="{Binding DataContext.ViewCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />

                                    <Button Content="✏" Margin="2"
                        Background="Transparent" BorderBrush="Transparent"
                        FontSize="12" Cursor="Hand"
                        Foreground="Blue"
                        Command="{Binding DataContext.EditCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />

                                    <Button Content="🗑" Margin="2"
                        Background="Transparent" BorderBrush="Transparent"
                        FontSize="12" Cursor="Hand"
                        Foreground="Red"
                        Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>

