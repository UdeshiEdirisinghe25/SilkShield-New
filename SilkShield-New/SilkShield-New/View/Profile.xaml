<Window x:Class="SilkShield_New.View.Profile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SilkShield_New.View"
        mc:Ignorable="d"
        Title="Profile" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/Back.PNG"/>
        </Grid.Background>
        <Label x:Name="ProfileLabel" Content="Profile" FontSize="24" Margin="10,10,702,0" Height="47" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Username" HorizontalAlignment="Left" Height="27" Margin="268,50,0,0" VerticalAlignment="Top" Width="77" FontWeight="Bold"/>
        <Label Content="Current Password" HorizontalAlignment="Left" Height="27" Margin="268,124,0,0" VerticalAlignment="Top" Width="124" FontWeight="Bold"/>
        <Label Content="New Password" HorizontalAlignment="Left" Height="27" Margin="268,194,0,0" VerticalAlignment="Top" Width="97" FontWeight="Bold"/>
        <Label Content="Confirm New Password" HorizontalAlignment="Left" Height="27" Margin="270,265,0,0" VerticalAlignment="Top" Width="124" FontWeight="Bold"/>
        <TextBox HorizontalAlignment="Left" Height="27" Margin="266,82,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="264" TextChanged="TextBox_TextChanged"/>
        <PasswordBox HorizontalAlignment="Left" Height="27" Margin="266,156,0,0" VerticalAlignment="Top" Width="264"/>
        <PasswordBox HorizontalAlignment="Left" Height="27" Margin="266,226,0,0" VerticalAlignment="Top" Width="264"/>
        <PasswordBox HorizontalAlignment="Left" Height="27" Margin="266,297,0,0" VerticalAlignment="Top" Width="264"/>
        
        
        <Button Content="Apply Changes" Margin="266,360,0,0" Click="Button_Click" Style="{StaticResource CurvedButtonStyle}" Height="32"  FontWeight="Bold" Width="264" Background="#FF111111" Foreground="#FFFCF3F3" HorizontalAlignment="Left" VerticalAlignment="Top"/>

    </Grid>
</Window>
