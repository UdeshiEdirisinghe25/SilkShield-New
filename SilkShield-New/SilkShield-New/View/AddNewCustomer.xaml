<UserControl x:Class="SilkShield_New.View.AddNewCustomer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Tag" Value="Placeholder text"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" />
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#A0A0A0"
                                           VerticalAlignment="Center"
                                           Margin="15,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type TextBox}}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D7" TargetName="TextBoxBorder"/>
                                <Setter Property="Background" Value="White" TargetName="TextBoxBorder"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="15,0,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Border x:Name="ComboBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <ToggleButton Name="ToggleButton"
                                              Grid.Column="2"
                                              Focusable="False"
                                              IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press"
                                              Background="Transparent">
                                    <ContentPresenter />
                                </ToggleButton>
                                <ContentPresenter Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="6,3,25,3"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" />
                                <Popup Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid Name="DropDown"
                                          SnapsToDevicePixels="True"
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border x:Name="DropDownBorder"
                                                Background="White"
                                                BorderBrush="#CCCCCC"
                                                BorderThickness="1"/>
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBoxBorder" Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBoxBorder" Property="BorderBrush" Value="#0078D7"/>
                                <Setter TargetName="ComboBoxBorder" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" CornerRadius="20" Padding="30" MaxWidth="900" Margin="0,-25,0,10">
                <StackPanel>
                    <TextBlock Text="New Customer"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#333333"
                               Height="34"/>
                    <TextBlock Text="Enter the new customer's information below."
                               FontSize="14"
                               Foreground="#666666"
                               TextWrapping="Wrap"
                               Margin="0,0,0,25"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Customer Name -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,20">
                            <TextBlock Text="Customer Name" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputFieldStyle}" Tag="Enter Name"
                                     Text="{Binding NewCustomer.CustomerName, Mode=TwoWay}" Height="30" Width="330" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Property Type -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="15,0,0,20">
                            <TextBlock Text="Property Type" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputFieldStyle}" 
                            Tag="Enter Property Type"
                            Text="{Binding NewCustomer.CustomerType, Mode=TwoWay}" 
                            Height="30" Width="330" HorizontalAlignment="Left"/>
                        </StackPanel>


                        <!-- Phone -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,20">
                            <TextBlock Text="Contact Number" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputFieldStyle}" Tag="Contact Number"
                                     Text="{Binding NewCustomer.PhoneNumber, Mode=TwoWay}" Height="30" Width="330" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="15,0,0,20">
                            <TextBlock Text="Email" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputFieldStyle}" Tag="Enter Email"
                                     Text="{Binding NewCustomer.Email, Mode=TwoWay}" Height="30" Width="330" HorizontalAlignment="Left" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Address -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,15,20">
                            <TextBlock Text="Address" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputFieldStyle}" TextWrapping="Wrap" AcceptsReturn="True"
                                     Tag="Enter Address"
                                     VerticalScrollBarVisibility="Auto" Width="330"
                                     Text="{Binding NewCustomer.Address, Mode=TwoWay}" Height="30" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Visited Status -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="15,0,0,20">
                            <TextBlock Text="Visit Status" Style="{StaticResource InputLabelStyle}"/>
                            <ComboBox Style="{StaticResource InputComboBoxStyle}" Width="330"
                                     Text="{Binding NewCustomer.VisitedStatus, Mode=TwoWay}" Height="30" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Visited"/>
                                <ComboBoxItem Content="Not Visited"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Project Confirmation -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,15,20">
                            <TextBlock Text="Project Confirmation Status" Style="{StaticResource InputLabelStyle}"/>
                            <ComboBox Style="{StaticResource InputComboBoxStyle}" Width="330"
                                     Text="{Binding NewCustomer.ProjectConfirmation, Mode=TwoWay}" Height="30" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Confirmed"/>
                                <ComboBoxItem Content="Pending"/>
                                <ComboBoxItem Content="Rejected"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Quotation Status -->
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="15,0,0,20">
                            <TextBlock Text="Quotation Status" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputFieldStyle}" 
             Width="330" Height="30" 
             HorizontalAlignment="Left"
             Tag="Enter quotation status"
             Text="{Binding NewCustomer.QuotationStatus, Mode=TwoWay}"/>
                        </StackPanel>


                        <!-- Property Details -->
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,20">
                            <TextBlock Text="Property Details" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputFieldStyle}" Height="30"
                                     Tag="Enter Property Deteails"
                                     Text="{Binding NewCustomer.Property_Details, Mode=TwoWay}" Width="728" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Project Start Date -->
                        <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,15,20">
                            <TextBlock Text="Project Start Date" Style="{StaticResource InputLabelStyle}" HorizontalAlignment="Left"/>
                            <DatePicker Width="365" SelectedDate="{Binding NewCustomer.Project_Start_Date, Mode=TwoWay}" Height="30"/>
                            
                        </StackPanel>

                        <!-- Expected Completion Date -->
                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="15,0,0,20">
                            <TextBlock Text="Expected Date of Completion" Style="{StaticResource InputLabelStyle}"/>
                            <DatePicker Width="330" SelectedDate="{Binding NewCustomer.Expected_Dateof_Completion, Mode=TwoWay}" Height="30"/>
                        </StackPanel>

                        <!-- Special Preferences -->
                        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,20">
                            <TextBlock Text="Special Preferences / Customization" Style="{StaticResource InputLabelStyle}"/>
                            <TextBox Style="{StaticResource InputFieldStyle}" Height="30" TextWrapping="Wrap" AcceptsReturn="True"
                                     Tag="Enter Special Preferences or customizations"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding NewCustomer.Special_Preferances, Mode=TwoWay}" Width="737" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Notes -->
                        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,20">
                            <TextBlock Text="Notes" Style="{StaticResource InputLabelStyle}" HorizontalAlignment="Left"/>
                            <TextBox Style="{StaticResource InputFieldStyle}" Height="35" Width="727" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Tag="If any notes..."
                                     Text="{Binding NewCustomer.Notes, Mode=TwoWay}"/>
                        </StackPanel>

                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel"
                        Background="Black"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Padding="30,15"
                        Margin="0,0,10,0"
                        Command="{Binding CancelCommand}">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Save Customer"
                        Background="#FF5B281C"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Padding="30,15"
                        Command="{Binding SaveCustomerCommand}">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
