<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="SilkShield_New.View.MainWindow"
        Title="MainWndow" Height="756" Width="1160" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen" ResizeMode="CanResize">


    <Window.Resources>
        <!-- Color Resources -->
        <SolidColorBrush x:Key="DarkBackgroundBrush" Color="#1C1C1C"/>
        <SolidColorBrush x:Key="WhiteBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DarkBlueBrush" Color="#344767"/>
        <SolidColorBrush x:Key="GreyBrush" Color="#7B809A"/>
        <SolidColorBrush x:Key="DarkNavyBrush" Color="#262A41"/>
        <SolidColorBrush x:Key="LightGreyBrush" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="RedGradientStart" Color="#E93B77"/>
        <SolidColorBrush x:Key="RedGradientEnd" Color="#DA1F63"/>
        <SolidColorBrush x:Key="GreenGradientStart" Color="#63B967"/>
        <SolidColorBrush x:Key="GreenGradientEnd" Color="#4BA64F"/>
        <SolidColorBrush x:Key="BlackGradientStart" Color="#3E3D45"/>
        <SolidColorBrush x:Key="BlackGradientEnd" Color="#202020"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="#E0822D"/>


        <LinearGradientBrush x:Key="OrangeButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E0822D" Offset="0"/>
            <GradientStop Color="#E0822D" Offset="1"/>
        </LinearGradientBrush>

        <!-- Card Style -->
        <Style x:Key="MetricCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource WhiteBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#40000000" BlurRadius="6" ShadowDepth="2" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#08FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Navigation Button Style -->
        <Style x:Key="ActiveNavButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="LightBlue" BlurRadius="15" ShadowDepth="0" Opacity="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Promo Button Style -->
        <Style x:Key="PromoButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource OrangeButtonBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,11,24,11"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#4DA85205" BlurRadius="24" ShadowDepth="4" Opacity="0.3"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="OrangeRed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Border Background="{StaticResource DarkBackgroundBrush}" CornerRadius="25">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="261"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <DockPanel Grid.Column="0" Margin="9,17,20,12" LastChildFill="False">

                <!-- Logout Button (fixed at bottom) -->
                <Button x:Name="logout" Click="Logout_Click"
                        DockPanel.Dock="Bottom"
                        Width="200" Height="46"
                        Style="{StaticResource NavButtonStyle}"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,0,20">
                    <TextBlock Text="LOGOUT" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- Sidebar content -->
                <StackPanel DockPanel.Dock="Top" Height="646">


                    <Rectangle Width="152" Height="126"
                               >
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Images/ss.png"/>
                        </Rectangle.Fill>
                    </Rectangle>







                    <!-- Promo Block -->

                    <!-- User Profile -->
                    <Button x:Name="Profile"  Style="{StaticResource NavButtonStyle}" Click="UserProfile_Click" Background="Transparent" BorderThickness="0" Height="113" Width="216" >
                        <StackPanel Margin="9,10,0,20">
                            <Grid Height="53" Width="158">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="33*"/>
                                    <ColumnDefinition Width="86*"/>
                                </Grid.ColumnDefinitions>
                                <fa:FontAwesome Icon="UserCircle" Foreground="White" FontSize="40" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center" Grid.ColumnSpan="2">
                                    <TextBlock Text="Profile" FontFamily="Inter" FontSize="20" FontWeight="Medium" Foreground="White" Width="104"/>
                                </StackPanel>

                            </Grid>
                        </StackPanel>
                    </Button>
                    <Border Width="230" Height="174" Background="#1A380E24" CornerRadius="28" Padding="16,24,16,16">
                        <Border.Effect>
                            <DropShadowEffect Color="#A5662500" BlurRadius="64" ShadowDepth="32" Opacity="0.65"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Let's start!" FontFamily="Inter" FontSize="16" FontWeight="SemiBold" Foreground="White" TextAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Creating or adding new invoices couldn't be easier" FontFamily="Inter" FontSize="13" FontWeight="Medium" Foreground="White" 
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>
                            <Button x:Name="invoice" Style="{StaticResource PromoButtonStyle}" Click="Invoice_Click" Height="48" Width="158"  >
                                <StackPanel Orientation="Horizontal" Width="135">
                                    <Border Width="15" Height="24" CornerRadius="12">
                                        <Path Data="M12,4L10.59,5.41L16.17,11H4V13H16.17L10.59,18.59L12,20L20,12L12,4Z" Fill="White" Stretch="Uniform" Width="12" Height="12"/>
                                    </Border>
                                    <TextBlock Text="Add New Invoice" FontSize="12" Width="99" Height="14" Foreground="white"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Navigation Menu -->
                    <StackPanel x:Name="Sidebar">
                        <TextBlock Text="MAIN" FontFamily="Inter" FontSize="11" FontWeight="Medium" Foreground="#52FFFFFF" Margin="20,0,0,4" />
                        <Button x:Name="dashboard" Style="{StaticResource ActiveNavButtonStyle}" Click="dashboard_click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" Margin="0,0,16,0">
                                    <Grid Height="24" VerticalAlignment="Top">
                                        <Rectangle Width="8" Height="8" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0"/>
                                        <Rectangle Width="8" Height="8" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>
                                        <Rectangle Width="8" Height="8" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                        <Rectangle Width="8" Height="8" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Dashboard"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="customer" Style="{StaticResource NavButtonStyle}" Click="customer_click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" Margin="0,0,16,0">
                                    <fa:FontAwesome Icon="Users" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Customer Details"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="inventory" Style="{StaticResource NavButtonStyle}" Click="Inventory_Click" >
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" Margin="0,0,16,0">
                                    <fa:FontAwesome Icon="Archive" Foreground="White" FontSize="16" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Inventory"/>
                            </StackPanel>
                        </Button>


                        <Button x:Name="history" Style="{StaticResource NavButtonStyle}" Click="History_Click" >
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="24" Margin="0,0,16,0">
                                    <fa:FontAwesome Icon="Archive" Foreground="White" FontSize="16" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="History"/>
                            </StackPanel>
                        </Button>


                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Main Content Area -->
            <Border Grid.Column="1"  CornerRadius="40" Margin="0,43,29,29">
                <Border.Background>
                    <ImageBrush ImageSource="/images/Back.PNG" Stretch="UniformToFill"/>
                </Border.Background>
                <ContentControl x:Name="MainContentArea" Margin="40"/>
            </Border>

            <!-- Top Bar -->
            <Grid Height="40" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown" Grid.Column="1" Margin="2,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Window Buttons -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                    <Button  Width="40" Height="40" Click="Minimize_Click" Background="Transparent" Foreground="White" BorderThickness="0"   Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:FontAwesome Icon="WindowMinimize" Foreground="White" FontSize="18" />
                    </Button>
                    <Button  Width="40" Height="40" Click="MaximizeRestore_Click" Background="Transparent" Foreground="White" BorderThickness="0"   Cursor="Hand">
                        <fa:FontAwesome Icon="WindowMaximize" Foreground="White" FontSize="18"  />
                    </Button>
                    <Button Width="40" Height="40" Click="Close_Click" Background="Transparent" Foreground="White" BorderThickness="0"  Cursor="Hand">
                        <fa:FontAwesome Icon="Close" Foreground="White" FontSize="25" />
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>







