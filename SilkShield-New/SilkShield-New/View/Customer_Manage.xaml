<UserControl x:Class="SilkShield_New.View.Customer_Manage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Customer Details"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="Black"/>
                <TextBlock Text="Manage your customer information and project status"
                           FontSize="14"
                           Foreground="Gray"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
        Content="+ Add Customer"
        Width="160" Height="40"
        FontWeight="SemiBold"
        FontSize="14"
        Foreground="White"
        Cursor="Hand"
        Command="{Binding AddCustomerCommand}"
        HorizontalAlignment="Right"
        VerticalAlignment="Center" >
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#5B281C"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF804031"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- SEARCH -->
        <Border Grid.Row="1"
                Background="#F0F0F0"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Search Customers by Name"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="#1F2937"
                           Margin="0,0,0,10"/>
                <Border CornerRadius="8"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Background="White"
                        Height="42">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#9CA3AF"
                                   VerticalAlignment="Center"
                                   Margin="10,0"/>
                        <TextBox Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Foreground="#9CA3AF"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- DATA GRID -->
        <Border Grid.Row="2"
                CornerRadius="14"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Background="White"
                Padding="0">

            <DataGrid x:Name="CustomerDataGrid"
                      Margin="0"
                      Background="Transparent"
                      BorderThickness="0"
                      ItemsSource="{Binding CustomersView}"
                      SelectedItem="{Binding SelectedCustomer}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      RowHeight="48"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      SelectionUnit="FullRow"
                      SelectionMode="Single"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True">

                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1F2937"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1F2937"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1F2937"/>
                    <Style TargetType="DataGridCell">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </DataGrid.Resources>

                <!-- HEADER STYLE -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Gray"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Height" Value="44"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- ROW STYLE -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#1F2937"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Border x:Name="RowBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="#E5E7EB"
                                            SnapsToDevicePixels="True">
                                        <DataGridCellsPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#F9FAFB"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#EFF6FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>

                <!-- CELL STYLE -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#1F2937"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <!-- COLUMNS -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="200"/>
                    <DataGridTextColumn Header="Contact Details" Binding="{Binding ContactDetails}" Width="180"/>
                    <DataGridTextColumn Header="Property Type" Binding="{Binding CustomerType}" Width="150"/>
                    <DataGridTemplateColumn Header="Visited Status" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="StatusBorder" CornerRadius="12" Padding="10,4" Background="#EAFBF1" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusEllipse" Width="8" Height="8" Fill="#22C55E" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding VisitedStatus}" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding VisitedStatus}" Value="Not Visited">
                                        <Setter TargetName="StatusBorder" Property="Background" Value="#FEF2F2"/>
                                        <Setter TargetName="StatusEllipse" Property="Fill" Value="#F43F5E"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Property Details" Binding="{Binding Property_Details}" Width="200"/>
                    <DataGridTextColumn Header="Quotations" Binding="{Binding QuotationStatus}" Width="150"/>
                    <DataGridTextColumn Header="Project Confirmation" Binding="{Binding ProjectConfirmation}" Width="150"/>
                    <DataGridTextColumn Header="Project Start Date" Binding="{Binding Project_Start_Date}" Width="150"/>
                    <DataGridTextColumn Header="Expected Completion Date" Binding="{Binding Expected_Dateof_Completion}" Width="180"/>
                    <DataGridTextColumn Header="Special Preferences" Binding="{Binding Special_Preferances}" Width="200"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="200"/>

                    <!-- ACTIONS -->
                    <DataGridTemplateColumn Header="Actions" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Width="32" Height="32" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1"
                                            Command="{Binding DataContext.ViewCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" ToolTip="View Customer">
                                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="SemiBold" Foreground="Green"/>
                                    </Button>
                                    <Button Width="32" Height="32" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" Margin="4,0,0,0"
                                            Command="{Binding DataContext.EditCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"                                            CommandParameter="{Binding}" ToolTip="Edit Customer">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="SemiBold" Foreground="Black"/>
                                    </Button>
                                    <Button Width="32" Height="32" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" Margin="4,0,0,0"
                                            Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" ToolTip="Delete Customer">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="SemiBold" Foreground="Red"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- FOOTER -->
        <TextBlock Grid.Row="3"
                   Text="{Binding CustomersView.Count, StringFormat='Total Customers: {0}'}"
                   Foreground="#667085"
                   FontSize="13"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>
