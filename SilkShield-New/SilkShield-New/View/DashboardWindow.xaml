<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="SilkShield_New.View.DashboardWindow"
             Background="White" >

    <UserControl.Resources>
        <!-- Color & Gradient Resources -->
        <SolidColorBrush x:Key="GreyBrush" Color="#7B809A"/>
        <SolidColorBrush x:Key="DarkBlueBrush" Color="#344767"/>
        <SolidColorBrush x:Key="LightGreyBrush" Color="#F0F2F5"/>
        <LinearGradientBrush x:Key="RedGradientBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="LightGoldenrodYellow" Offset="0"/>
            <GradientStop Color="White" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GreenGradientBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="IndianRed" Offset="0"/>
            <GradientStop Color="white" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BlackGradientBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="LightGreen" Offset="0" />
            <GradientStop Color="White" Offset="1"/>
        </LinearGradientBrush>

        <!-- Card Style -->
        <Style x:Key="MetricCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#40000000" BlurRadius="6" ShadowDepth="2" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="44.4"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto" MinHeight="197"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Dashboard" FontFamily="Roboto" FontSize="32" 
                       FontWeight="SemiBold" Foreground="{StaticResource DarkBlueBrush}" VerticalAlignment="Center"/>
            
        </Grid>

        <!-- Metric Cards -->
        <UniformGrid Columns="3" Margin="0,24,0,30" Grid.RowSpan="2" Grid.Row="1">
            <!-- Card 1 -->
            <Border Style="{StaticResource MetricCardStyle}" Height="167">
                <Grid>
                    <Border Grid.Row="0" Background="{StaticResource RedGradientBrush}" CornerRadius="8" Height="96" Margin="9,11,9,0"/>
                    <TextBlock Text="Upcoming projects" FontFamily="Roboto" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DarkBlueBrush}" Margin="5,141,8,0"/>
                </Grid>
            </Border>

            <!-- Card 2 -->
            <Border Style="{StaticResource MetricCardStyle}" Height="167">
                <Grid>
                    <Border Grid.Row="0" Background="{StaticResource GreenGradientBrush}" CornerRadius="8" Height="96" Margin="9,11,9,0"/>
                    <TextBlock Text="ongoing project" FontFamily="Roboto" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DarkBlueBrush}" Margin="13,142,0,0"/>
                </Grid>
            </Border>

            <!-- Card 3 -->
            <Border Style="{StaticResource MetricCardStyle}" Height="167">
                <Grid>
                    <Border Grid.Row="0" Background="{StaticResource BlackGradientBrush}" CornerRadius="8" Height="96" Margin="9,11,9,0"/>
                    <TextBlock Text="Completed Tasks" FontFamily="Roboto" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DarkBlueBrush}" Margin="13,142,0,0"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Additional Content -->
        <Border Grid.Row="2"
        Background="{StaticResource LightGreyBrush}"
        CornerRadius="15"
        Padding="20"
        Margin="0,197,0,0"
        Grid.RowSpan="2">

            <StackPanel>
                <!-- Section Header -->
                <TextBlock Text="Recent Invoices"
                   FontFamily="Roboto"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{StaticResource GreyBrush}"
                   Margin="0,0,0,10"/>

                <!-- List of invoices -->
                <ListView ItemsSource="{Binding RecentInvoices}"
                  BorderThickness="0"
                  Background="Transparent" av:ItemsSource="{av:SampleData ItemCount=5}" SelectionChanged="ListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8"
                            Padding="10"
                            Margin="0,5,0,5"
                            Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Customer name and date -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding CustomerName}"
                                           FontWeight="Bold"
                                           FontSize="14"/>
                                        <TextBlock Text="{Binding InvoiceDate, StringFormat=\{0:yyyy-MM-dd\}}"
                                           FontSize="12"
                                           Foreground="Gray"/>
                                    </StackPanel>

                                    <!-- Amount -->
                                    <TextBlock Grid.Column="1"
                                       Text="{Binding Amount, StringFormat=\{0:N2\}}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
